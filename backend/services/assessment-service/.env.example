# Copy to .env, or run make service-env after make dev-init.
# Docker network addresses; override for a separately hosted dependency.
DATABASE_URL=postgres://saya_assessment:@postgres:5432/saya_assessment?sslmode=disable
RABBIT_URL=amqp://saya:@rabbitmq:5672/
SURVEY_ADDRESS=survey:9000
CENTRIFUGO_URL=http://centrifugo:8000
CENTRIFUGO_API_KEY=

# Optional, base64-encoded service account JSON for FCM HTTP v1 (secret).
FCM_SERVICE_ACCOUNT_B64=
