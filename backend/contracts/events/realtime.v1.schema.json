{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "realtime.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "assessment_id",
    "status",
    "version"
  ],
  "properties": {
    "event": {
      "enum": [
        "demo.completed",
        "assessment.completed",
        "assessment.failed"
      ]
    },
    "assessment_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "version": {
      "const": 1
    }
  }
}
