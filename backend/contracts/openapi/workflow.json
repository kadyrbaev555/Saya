{
  "openapi": "3.0.3",
  "info": {
    "title": "SAYA Workflow API",
    "version": "1.3.0"
  },
  "paths": {
    "/api/v1/surveys/current": {
      "get": {
        "summary": "Versioned demonstration questionnaire",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/api/v1/surveys/submissions": {
      "post": {
        "summary": "Submit voluntary demonstration answers; asynchronous assessment",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submission"
              }
            }
          }
        }
      }
    },
    "/api/v1/assessments/{id}": {
      "get": {
        "summary": "Owned pending, completed or failed result",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/realtime/connection-token": {
      "post": {
        "summary": "Short-lived Centrifugo connection JWT",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/api/v1/realtime/subscription-token": {
      "post": {
        "summary": "Owned channel Centrifugo subscription JWT",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel"
                ],
                "properties": {
                  "channel": {
                    "type": "string",
                    "pattern": "^user:[0-9a-f-]+:assessments$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Submission": {
        "type": "object",
        "required": [
          "questionnaire_id",
          "version",
          "answers",
          "consent",
          "idempotency_key"
        ],
        "properties": {
          "questionnaire_id": {
            "type": "string",
            "enum": [
              "saya-demo"
            ]
          },
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "answers": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "immediate_threat",
              "information_requested"
            ],
            "properties": {
              "immediate_threat": {
                "type": "boolean"
              },
              "information_requested": {
                "type": "boolean"
              }
            }
          },
          "consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "external_llm_consent": {
            "type": "boolean",
            "default": false
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
