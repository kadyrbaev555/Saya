{
  "openapi": "3.0.3",
  "info": {
    "title": "SAYA Workflow API",
    "version": "1.3.0"
  },
  "paths": {
    "/api/v1/surveys/current": {
      "get": {
        "summary": "Versioned demonstration questionnaire",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/api/v1/surveys/submissions": {
      "post": {
        "summary": "Submit voluntary demonstration answers; asynchronous assessment",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Submission"
                  },
                  {
                    "$ref": "#/components/schemas/WeeklySubmission"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/assessments/{id}": {
      "get": {
        "summary": "Owned pending, completed or failed result",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/realtime/connection-token": {
      "post": {
        "summary": "Short-lived Centrifugo connection JWT",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/api/v1/realtime/subscription-token": {
      "post": {
        "summary": "Owned channel Centrifugo subscription JWT",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel"
                ],
                "properties": {
                  "channel": {
                    "type": "string",
                    "pattern": "^user:[0-9a-f-]+:assessments$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/surveys/interview": {
      "get": {
        "summary": "Weekly interview with approved question variants",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/api/v1/surveys/latest": {
      "get": {
        "summary": "Latest owned submission ID, empty for a new profile",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/api/v1/surveys/interview/focus": {
      "post": {
        "summary": "Select an approved question perspective using Gemini with explicit consent",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "503": {
            "description": "Dependency unavailable"
          },
          "200": {
            "description": "Success"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "topic",
                  "consent"
                ],
                "properties": {
                  "topic": {
                    "type": "string",
                    "enum": [
                      "housing",
                      "expenses",
                      "work",
                      "connection",
                      "daily",
                      "priority"
                    ]
                  },
                  "ratings": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    }
                  },
                  "consent": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/support/vacancies": {
      "post": {
        "summary": "Search HeadHunter vacancies in the pilot city",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "area",
                  "text"
                ],
                "properties": {
                  "area": {
                    "type": "string",
                    "enum": [
                      "160"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HeadHunter results, in provider order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "title",
                          "employer",
                          "url"
                        ],
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "employer": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid search"
          },
          "401": {
            "description": "Session required"
          },
          "502": {
            "description": "Invalid provider response"
          },
          "503": {
            "description": "HeadHunter unavailable or access denied"
          }
        }
      }
    },
    "/api/v1/weekly/history": {
      "get": {
        "summary": "Current owner's weekly results, newest first (up to 20)",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "before",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "entries with id, completed_at (Unix seconds), version, nullable percentage, ratings and directions; next_cursor, next_due (Unix seconds), reminder_due and push_available."
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/weekly/device": {
      "post": {
        "summary": "Change this Android installation's weekly reminder preference",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "installation_id",
                  "enabled"
                ],
                "properties": {
                  "installation_id": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Preference saved"
          },
          "400": {
            "description": "Invalid device request"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/appeals": {
      "get": {
        "summary": "Public moderated catalog",
        "security": [],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
