    "/api/v1/payments/card": {
      "post": {
        "summary": "Signed Freedom Pay notification",
        "security": [],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "pg_xml": {
                    "type": "string"
                  }
                },
                "required": [
                  "pg_xml"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/payout": {
      "post": {
        "summary": "Signed Freedom Pay notification",
        "security": [],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "pg_xml": {
                    "type": "string"
                  }
                },
                "required": [
                  "pg_xml"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/result": {
      "post": {
        "summary": "Signed Freedom Pay notification",
        "security": [],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "pg_order_id": {
                    "type": "string"
                  },
                  "pg_payment_id": {
                    "type": "string"
                  },
                  "pg_sig": {
                    "type": "string"
                  },
                  "pg_amount": {
                    "type": "string"
                  },
                  "pg_currency": {
                    "type": "string"
                  },
                  "pg_result": {
                    "type": "string"
                  }
                },
                "required": [
                  "pg_order_id",
                  "pg_payment_id",
                  "pg_sig",
                  "pg_amount",
                  "pg_currency",
                  "pg_result"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Submission": {
        "type": "object",
        "required": [
          "questionnaire_id",
          "version",
          "answers",
          "consent",
          "idempotency_key"
        ],
        "properties": {
          "questionnaire_id": {
            "type": "string",
            "enum": [
              "saya-demo"
            ]
          },
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "answers": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "immediate_threat",
              "information_requested"
            ],
            "properties": {
              "immediate_threat": {
                "type": "boolean"
              },
              "information_requested": {
                "type": "boolean"
              }
            }
          },
          "consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "external_llm_consent": {
            "type": "boolean",
            "default": false
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "WeeklySubmission": {
        "type": "object",
        "required": [
          "questionnaire_id",
          "version",
          "consent",
          "idempotency_key"
        ],
        "properties": {
          "questionnaire_id": {
            "enum": [
              "saya-week"
            ],
            "type": "string"
          },
          "version": {
            "enum": [
              2
            ],
            "type": "integer"
          },
          "answers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "immediate_threat": {
                "type": "boolean"
              }
            }
          },
          "consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "external_llm_consent": {
            "type": "boolean",
            "default": false
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          },
          "responses": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 800
            }
          },
          "ratings": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "summary": {
            "type": "string",
            "maxLength": 1800
          },
          "needs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "housing",
                "jobs",
                "psychologist",
                "social",
                "financial"
              ]
            }
          },
          "question_focus": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "routine",
                "resources",
                "obstacles"
              ]
            }
          }
        }
      }
    }
  }
}
