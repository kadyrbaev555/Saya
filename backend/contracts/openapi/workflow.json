        ],
        "responses": {
          "204": {
            "description": "Success"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "consent": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "description",
                  "consent"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/appeals/{id}/approve": {
      "post": {
        "summary": "Approve appeal",
        "security": [
