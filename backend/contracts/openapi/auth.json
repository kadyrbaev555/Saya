{
  "openapi": "3.0.3",
  "info": {
    "title": "SAYA implemented Auth API",
    "version": "1.3.0"
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Access token and user; refresh and CSRF cookies set"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "409": {
            "description": "Account unavailable"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token and user; refresh and CSRF cookies set"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "409": {
            "description": "Account unavailable"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "refresh",
        "description": "Requires saya_refresh and saya_csrf cookies, matching X-CSRF-Token header. Cookie SameSite Strict; Secure in HTTPS.",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Refresh invalid or replayed"
          },
          "403": {
            "description": "CSRF or cookie missing"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "logout",
        "description": "Requires saya_refresh and saya_csrf cookies, matching X-CSRF-Token header. Cookie SameSite Strict; Secure in HTTPS.",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "401": {
            "description": "Refresh invalid or replayed"
          },
          "403": {
            "description": "CSRF or cookie missing"
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Own user profile"
          },
          "401": {
            "description": "Invalid access token"
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "responses": {
          "200": {
            "description": "Ed25519 public key set"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
