{
  "openapi": "3.0.3",
  "info": {
    "title": "SAYA implemented Auth API",
    "version": "1.3.0"
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Request registration code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "full_name",
                  "phone"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  },
                  "full_name": {
                    "type": "string",
                    "maxLength": 180
                  },
                  "phone": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Invalid input"
          },
          "409": {
            "description": "Account unavailable"
          },
          "202": {
            "description": "Verification email accepted by SMTP",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "registration_id"
                  ],
                  "properties": {
                    "registration_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Retry after one minute"
          },
          "503": {
            "description": "Email delivery unavailable"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token and user; refresh and CSRF cookies set"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "409": {
            "description": "Account unavailable"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "refresh",
        "description": "Requires saya_refresh and saya_csrf cookies, matching X-CSRF-Token header. Cookie SameSite Strict; Secure in HTTPS.",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Refresh invalid or replayed"
          },
          "403": {
            "description": "CSRF or cookie missing"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "logout",
        "description": "Requires saya_refresh and saya_csrf cookies, matching X-CSRF-Token header. Cookie SameSite Strict; Secure in HTTPS.",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "401": {
            "description": "Refresh invalid or replayed"
          },
          "403": {
            "description": "CSRF or cookie missing"
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Own user profile"
          },
          "401": {
            "description": "Invalid access token"
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "responses": {
          "200": {
            "description": "Ed25519 public key set"
          }
        }
      }
    },
    "/api/v1/auth/register/confirm": {
      "post": {
        "summary": "Verify email and create account and session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "registration_id",
                  "code"
                ],
                "properties": {
                  "registration_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Access token and user; refresh and CSRF cookies set"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "409": {
            "description": "Account unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
