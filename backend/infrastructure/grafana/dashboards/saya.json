{
  "uid": "saya",
  "title": "SAYA local",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up",
          "refId": "A"
        },
        {
          "expr": "saya_dependency_up",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(saya_http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(saya_http_requests_total{status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(saya_http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s"
}
