# make dev-init creates independent random secrets, permissions 0600; never commit .env
DB_ADMIN_PASSWORD=
DB_PASSWORD=
SURVEY_DB_PASSWORD=
ASSESSMENT_DB_PASSWORD=
RABBIT_PASSWORD=
JWT_SEED=
JWT_PUBLIC=
JWT_KID=local-1
# Optional JSON map kid -> base64url Ed25519 public key, containing current and retiring keys
JWT_PUBLIC_KEYS=
CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_API_KEY=
GRAFANA_PASSWORD=

# JWT fields seed initial service-env generation; edit active JWT settings in service .env files.
# Configure LLM in backend/services/ai-service/.env.
